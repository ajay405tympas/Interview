
func convertStringtoInt(str string) int {
	var number int = 0
	for i := range str {
		num := int(str[i])
		if num != 0 || len(str) > 1 {
			num = num - 48

			for j := 1; j < len(str)-i; j++ {
				num = num * 10
			}
			fmt.Println("num is", num)
			number = number + num
		} else {
			number = 0
		}

	}
	fmt.Println("number is::", number)
	return int(number)
}

func convertInttoStr(num int) string {
	result := ""
	if num != 0 {
		for num > 0 {
			digit := num % 10
			result = string(digit+'0') + result
			num = num / 10
		}

	} else {
		result = string('0') + result
	}
	return result
}

func multiply(num1 string, num2 string) string {

	var num_1 int
	var num_2 int

	num_1 = convertStringtoInt(num1)
	num_2 = convertStringtoInt(num2)

	result := num_1 * num_2
	fmt.Println("num1 , num2", num_1, num_2)
	fmt.Println("num1 * num2", result)

	return convertInttoStr(result)
}